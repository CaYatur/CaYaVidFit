<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CaYaVidFit</AssemblyName>
    <RootNamespace>CaYaVidFit</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>ÇAĞAN TURGUT / CaYaDev</Authors>
    <Description>Windows video size fitter (ffmpeg) — CaYaVidFit MVP</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Self-contained win-x64 when publishing -->
  <PropertyGroup Condition="'$(PublishSingleFile)'=='true' or '$(SelfContained)'=='true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
