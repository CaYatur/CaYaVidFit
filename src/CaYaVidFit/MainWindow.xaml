<Window x:Class="CaYaVidFit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaYaVidFit - Video Size Fitter"
        WindowStartupLocation="CenterScreen"
        Height="680" Width="920"
        MinHeight="560" MinWidth="800"
        SizeToContent="Manual"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Background="{StaticResource BgBrush}"
        Icon="Assets/app.ico"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave">
  <Grid>
    <DockPanel Margin="16" x:Name="MainDock">

    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/logo.png" Width="40" Height="40" Margin="0,0,12,0"
               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="CaYaVidFit" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtSubtitle" Text="Fit video size with ffmpeg"
                     Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="FfmpegStatusText" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{StaticResource MutedBrush}" Text="ffmpeg: …"/>
        <Button x:Name="BtnRefreshFfmpeg" Content="Refresh" Click="BtnRefreshFfmpeg_Click"/>
        <Button x:Name="BtnInstallFfmpeg" Content="Install ffmpeg" Click="BtnInstallFfmpeg_Click"/>
      </StackPanel>
    </DockPanel>

    <!-- Bottom actions FIRST so they always keep space -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button x:Name="BtnStart" Style="{StaticResource PrimaryButton}" Content="Start" Click="BtnStart_Click"/>
        <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" IsEnabled="False" Margin="0"/>
      </StackPanel>
      <StackPanel Margin="0,0,12,0">
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="12"/>
        <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="Ready" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
    </DockPanel>

<!-- Drop zone (visible) -->
    <Border x:Name="DropZone" DockPanel.Dock="Top" Margin="0,0,0,8" MinHeight="88"
            Background="#180C0C" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
            CornerRadius="10" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
            MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtDropTitle" Grid.Row="0" Text="Drop video here"
                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Left"/>
        <TextBlock x:Name="TxtDropHint" Grid.Row="1" Text="or click Browse - MP4, MKV, MOV, AVI, WEBM..."
                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
        <DockPanel Grid.Row="2" LastChildFill="True">
          <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="Browse..." Click="BtnBrowse_Click"
                  MinWidth="110" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtInput" IsReadOnly="True" VerticalAlignment="Center"
                   Background="{StaticResource InputBrush}" BorderThickness="1"/>
        </DockPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="TxtProbe" DockPanel.Dock="Top" Margin="2,0,0,6"
               Text="No video selected" TextWrapping="Wrap"
               Foreground="{StaticResource MutedBrush}"/>

    <!-- Mode (compact 2-col) -->
    <GroupBox Header="Mode" DockPanel.Dock="Top" Margin="0,0,0,8"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" Padding="8">
      <GroupBox.HeaderTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold"/>
        </DataTemplate>
      </GroupBox.HeaderTemplate>
      <StackPanel>
        <UniformGrid Columns="2">
          <RadioButton x:Name="RbHigh" GroupName="EncodeMode" Content="Shrink High (~95%)" Checked="Mode_Changed" Margin="0,2,8,2"/>
          <RadioButton x:Name="RbQualityPlus" GroupName="EncodeMode" Content="Boost Quality+ (~125%)" Checked="Mode_Changed" Margin="0,2,0,2"/>
          <RadioButton x:Name="RbMedium" GroupName="EncodeMode" Content="Shrink Medium (~82%)" IsChecked="True" Checked="Mode_Changed" Margin="0,2,8,2"/>
          <RadioButton x:Name="RbUltra" GroupName="EncodeMode" Content="Boost Ultra (~160%)" Checked="Mode_Changed" Margin="0,2,0,2"/>
          <RadioButton x:Name="RbLow" GroupName="EncodeMode" Content="Shrink Low (~65%)" Checked="Mode_Changed" Margin="0,2,8,2"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
            <RadioButton x:Name="RbTarget" GroupName="EncodeMode" Content="Target MB:" Checked="Mode_Changed" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTargetMb" Width="56" Text="25" Margin="6,0,4,0" VerticalAlignment="Center"
                     TextChanged="TxtTargetMb_TextChanged" Padding="6,4"/>
            <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </UniformGrid>
        <CheckBox x:Name="ChkStreamCopy" Margin="0,6,0,0" Foreground="{StaticResource FgBrush}"
                  Content="Stream copy if under target / budget too tight"
                  IsChecked="True" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
      </StackPanel>
    </GroupBox>

    <!-- Compact export row: format + output -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="8" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LblFormat" Grid.Column="0" Text="Format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="CmbFormat" Grid.Column="1" VerticalAlignment="Center" MinHeight="36"
                  SelectionChanged="CmbFormat_SelectionChanged">
          <ComboBoxItem Tag="same" IsSelected="True" Content="Same as input"/>
          <ComboBoxItem Tag=".mp4" Content="MP4"/>
          <ComboBoxItem Tag=".mkv" Content="MKV"/>
          <ComboBoxItem Tag=".mov" Content="MOV"/>
          <ComboBoxItem Tag=".webm" Content="WEBM"/>
          <ComboBoxItem Tag=".avi" Content="AVI"/>
        </ComboBox>
        <TextBlock x:Name="LblOutput" Grid.Column="3" Text="Output:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="TxtOutput" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="BtnBrowseOut" Grid.Column="5" Content="Browse..." Click="BtnBrowseOut_Click"
                MinWidth="96" Margin="0" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Compact command + log side by side (fills remaining) -->
    <Grid Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="8" Padding="10,8" MinHeight="120">
        <DockPanel LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
            <Button x:Name="BtnCopyCmd" DockPanel.Dock="Right" Content="Copy" Click="BtnCopyCmd_Click"
                    MinWidth="72" MaxWidth="130" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                    Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center"/>
            <TextBlock x:Name="LblCommand" Text="ffmpeg command" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox x:Name="TxtCommand" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushKey}"
                   BorderThickness="1" Padding="8" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   Foreground="{StaticResource FgBrush}" CaretBrush="{StaticResource FgBrush}"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="8" Padding="10,8" MinHeight="120">
        <DockPanel LastChildFill="True">
          <TextBlock x:Name="LblLog" DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11" LineHeight="16"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>

    <!-- Drag-drop import overlay (animated) -->
    <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#CC050505"
            IsHitTestVisible="False" Opacity="0">
      <Border.Effect>
        <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
      </Border.Effect>
      <Border Margin="24" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
              CornerRadius="16" Background="#33C42021">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Opacity" Value="1"/>
          </Style>
        </Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="TxtDropOverlayTitle" Text="Drop to import" FontSize="28" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Foreground="White"/>
          <TextBlock x:Name="TxtDropOverlayHint" Text="Release to load this video" Margin="0,10,0,0"
                     HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
          <TextBlock Text="⬇" FontSize="42" HorizontalAlignment="Center" Margin="0,18,0,0"
                     Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
